# Prefer python scripts/configure.py for secure generated values.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
READER_PASSWORD=replace-with-another-random-hex-password
APP_DB_PASSWORD=replace-with-another-random-hex-password
APP_TOKEN=replace-with-a-random-token-at-least-24-characters
# One personal token per reviewer: name:token pairs, comma-separated. Add with: python scripts/configure.py --add-reviewer NAME
REVIEWERS=reviewer:replace-with-a-different-random-token-at-least-24-characters
AGENT_MODE=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Optional: a different model for the independent AI reviewer (defaults to LLM_MODEL).
LLM_REVIEW_MODEL=
LLM_API_KEY=
